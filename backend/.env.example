# Copy to backend/.env and fill in real values. Read by app/core/config.py.
# Never commit backend/.env it is gitignored.

# development | staging | production
APP_ENV=development

# Migration connection (port 5432) used by Alembic.
# Supabase's direct host (db.<project-ref>.supabase.co) is IPv4-deprecated and may
# not resolve at all; the SESSION pooler below is the IPv4-compatible equivalent
# and supports migrations. Percent-encode specials in the password: @ -> %40, : -> %3A.
DATABASE_URL=postgresql+psycopg://postgres.YOUR-PROJECT-REF:YOUR%40PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres

# TRANSACTION pooler (port 6543, pgbouncer) app runtime connection.
# Disable prepared statements on this one (psycopg prepare_threshold=None):
# pgbouncer transaction mode does not support them.
DATABASE_URL_POOLED=postgresql+psycopg://postgres.YOUR-PROJECT-REF:YOUR%40PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres

# Supabase project REST URL.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# service_role key (NOT the anon key) the backend needs full storage access
# for Course Scheme file uploads. Secret: never expose it to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated list of frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000

# Gemini API key for the function-calling chatbot (docs/PROJECT_ARCHITECTURE.md §8).
# Get one free at https://aistudio.google.com/apikey. Leave unset and the rest of the
# app still works; POST /api/v1/chat reports a clear "not configured" error instead.
GEMINI_API_KEY=your-gemini-api-key
