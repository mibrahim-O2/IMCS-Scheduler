# Copy to backend/.env and adjust. Read by app/core/config.py.

# development | staging | production
APP_ENV=development

# Declared only; nothing connects to the database until the DB phase.
DATABASE_URL=postgresql+psycopg://imcs:imcs@localhost:5432/imcs_scheduler

# Comma-separated list of frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000
